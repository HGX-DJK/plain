# ============================================================
# Docker Compose 宿主机外挂路径配置模板
# 复制本文件为 .env 后，按需修改各项路径即可
# ============================================================

# 1. 宿主机后端代码路径（外挂到容器 /app/backend）
HOST_BACKEND_PATH=./backend

# 2. 宿主机前端构建产物目录（外挂到容器 /app/web/dist）
HOST_WEB_DIST_PATH=./web/dist

# 3. 宿主机上传文件持久化目录（外挂到容器 /app/backend/uploads）
HOST_UPLOAD_PATH=./data/uploads

# 4. 服务对外访问端口（宿主机端口）
HOST_PORT=8100
