# ============================================================
# 后端配置模板：复制为 backend/.env 后按现场修改
# 后端所有可能随部署环境变化的配置项都集中在本文件；
# 前端（底图、接口前缀）配置见 web/public/js/config.js，两者互不引用。
# ============================================================

# ---- 服务监听 ----
# 0.0.0.0 表示监听所有网卡；仅允许本机访问可改为 127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8100

# ---- 数据库 ----
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=plains
PG_USER=postgres
PG_PASSWORD=change-me

# ---- 鉴权 ----
# 上线务必换成足够长的随机串（改动后已登录用户需重新登录）
JWT_SECRET=please-replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ---- 空间参数 ----
# PostGIS 几何列 SRID：4490=CGCS2000，4326=WGS84；修改后需同步重建几何列
SPATIAL_SRID=4490
# 采集默认中心（经纬度），留空则使用系统参数页中的值
MAP_CENTER_LNG=
MAP_CENTER_LAT=
MAP_DEFAULT_ZOOM=16

# ---- 经纬度比对 ----
# 默认超差阈值（米）
COMPARE_DEFAULT_THRESHOLD_M=10

# ---- 跨域 ----
# 同源部署（后端托管前端 dist）保持 * 即可；分离部署填前端访问地址，逗号分隔
CORS_ORIGINS=*

# ---- 上传文件 ----
# 上传根目录，相对路径以 backend 目录为基准
UPLOAD_DIR=uploads
# 上传文件的访问前缀（由后端静态托管）
UPLOAD_URL_PREFIX=/api/uploads
# 单文件上传上限（MB）
FACADE_MAX_UPLOAD_MB=60
# 外景缩略图边长（像素）
FACADE_THUMB_SIZE=720

# ---- 前端构建产物托管 ----
# 前端 dist 目录，相对路径以 backend 目录为基准；
# 前后端分离部署（前端由 nginx 托管）时该目录不存在，后端只提供 API
WEB_DIST=../web/dist
